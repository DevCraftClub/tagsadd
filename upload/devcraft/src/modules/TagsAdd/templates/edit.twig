<h2>{{ page_title }}</h2>

{% if item %}
    <form class="js-tags-edit-form" data-id="{{ item.id }}">
        <div class="form-group">
            <label>{{ 'ID новости'|trans }}</label>
            <input type="text" class="metro-input" value="{{ item.news_id }}" readonly>
        </div>
        <div class="form-group">
            <label>{{ 'Пользователь'|trans }}</label>
            <input type="text" class="metro-input" value="{{ item.user_name }}" readonly>
        </div>
        <div class="form-group">
            <label>{{ 'Дата'|trans }}</label>
            <input type="text" class="metro-input" value="{{ item.date }}" readonly>
        </div>
        <div class="form-group">
            <label>{{ 'Теги'|trans }}</label>
            <input type="text" name="tags" id="tags" class="metro-input"
                   value="{{ item.tags }}" data-role="tag-input">
        </div>
        <div class="d-flex flex-wrap gap-2 mt-3">
            <button type="button" class="button primary js-tags-save">{{ 'Сохранить'|trans }}</button>
            <button type="button" class="button success js-tags-approve" data-id="{{ item.id }}">{{ 'Одобрить'|trans }}</button>
            <button type="button" class="button warning js-tags-reject" data-id="{{ item.id }}">{{ 'Отклонить'|trans }}</button>
            <a class="button" href="?mod=tags_add&action=suggestions">{{ 'К списку'|trans }}</a>
        </div>
    </form>
{% else %}
    <p class="fg-gray">{{ 'Предложение не найдено.'|trans }}</p>
    <a class="button" href="?mod=tags_add&action=suggestions">{{ 'К списку'|trans }}</a>
{% endif %}
